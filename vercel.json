{
  "routes": [
    {
      "src": "/yandex_[a-f0-9]{16}\\.html",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "/google-site-verification=.*\\.html",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ]
}